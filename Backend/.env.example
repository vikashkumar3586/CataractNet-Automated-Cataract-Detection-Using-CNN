# MongoDB settings
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cataractnet?retryWrites=true&w=majority
MONGODB_DB=cataractnet

# JWT secret for auth
JWT_SECRET=your_jwt_secret_here

# Cloudinary settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: frontend URL if you need CORS or redirects
FRONTEND_URL=http://localhost:5173
